# Environment Configuration for Voice-Enabled RAG Pipeline (HH Goa 2026)

# STT Providers (Pick one or both)
SARVAM_API_KEY=your_sarvam_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
STT_PROVIDER=sarvam  # sarvam | elevenlabs | local

# Generation LLM Providers (Optional for external LLMs, defaults to fast local synthesis)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=fast_local  # fast_local | gemini | groq | openai

# Pipeline Settings
DEFAULT_CHUNKING_STRATEGY=hierarchical  # hierarchical | semantic | metadata_aware | sentence_window
LATENCY_TARGET_MS=200.0
ENABLE_SEMANTIC_CACHE=true
PORT=8000
HOST=0.0.0.0
