{
  "name": "Voice-Enabled RAG System (HH Goa 2026)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Voice RAG Web UI",
      "onAutoForward": "openBrowser"
    }
  }
}
